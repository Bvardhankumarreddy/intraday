# Copy to .env. Never commit .env.
# NSE_CONFIG_FILE=config/settings.yaml
# NSE_LOG_LEVEL=INFO
# NSE_RISK__RISK_PCT=0.5

# Groww Trading API (live market data only; this project never places orders).
# TOTP key (recommended, no daily approval): the TOTP token + TOTP secret.
# NSE_BROKER_API_KEY=<TOTP token>
# NSE_BROKER_TOTP_SECRET=<TOTP secret>
# Or an approval key (needs approval on Groww's API-keys page every day):
# NSE_BROKER_API_KEY=<API key>
# NSE_BROKER_API_SECRET=<API secret>

# AI research agent (Phase 10). Default provider is the offline mock.
# NSE_LLM__PROVIDER=anthropic
# NSE_LLM__MODEL=claude-haiku-5-5
# NSE_LLM_API_KEY=<Anthropic API key>
# NSE_LLM__WORKSPACE_ID=<workspace id; only if the key is not workspace-scoped>

